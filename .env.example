# Global environment variables
# Copy to .env and fill in your values

# ── AI Provider ──────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./triage.db
# For Postgres (production): postgresql://user:password@localhost:5432/triage_db

# ── Security ─────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ENCRYPTION_KEY=  # Leave empty to auto-generate a Fernet key on startup

# ── Retention ────────────────────────────────────────────────
DATA_RETENTION_HOURS=24  # Demo mode: 24h TTL for all patient data

# ── Environment ───────────────────────────────────────────────
ENVIRONMENT=development  # development | production
